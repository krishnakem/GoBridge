{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(npm run deploy:prod*)",
      "Bash(npx wrangler deploy --env production*)",
      "Bash(wrangler deploy --env production*)",
      "Bash(npx wrangler secret put * --env production*)",
      "Bash(wrangler secret put * --env production*)",
      "Bash(npx wrangler kv * --env production*)",
      "Bash(wrangler kv * --env production*)",
      "Read(.dev.vars)",
      "Read(**/*.dev.vars)",
      "Bash(*wrangler* --env production*)",
      "Bash(*wrangler* --env=production*)",
      "Bash(*wrangler* -e production*)",
      "Bash(*.dev.vars*)",
      "Read(**/.dev.vars*)"
    ]
  }
}
