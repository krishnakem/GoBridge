SPEC.md

# Secrets — never commit
.dev.vars
.dev.vars.*
.env
.env.*

# Google / service credential JSON files
client_secret*.json
credentials*.json
service-account*.json
*-credentials.json
*.keys.json

# Wrangler / build output
.wrangler/
node_modules/
dist/

# OS / editor
.DS_Store
*.log

# Owner-only review documents — keep local, like SPEC.md
SECURITY_REVIEW.md
PROD_CHECKLIST.md

# Markdown files stay local (rules, specs, reviews). README.md is the one exception.
*.md
!README.md

# Backups, local tool settings, keys
*.bundle
md-backup/
.claude/settings.local.json
.vscode/
.idea/
coverage/
*.pem
*.key

# LinkedIn post visual (TikZ source + renders) — keep local
linkedin/
