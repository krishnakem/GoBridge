/**
 * GoBridge Wrangler configuration.
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Two environments, each with its OWN KV namespaces, D1 audit database,
 * Durable Objects and secrets:
 *   dev        -> worker "gobridge-dev"  (npm run deploy:dev)
 *   production -> worker "gobridge"      (owner only: npm run deploy:prod)
 *
 * No secrets belong in this file. Secrets are set with `wrangler secret put`
 * (deployed) or `.dev.vars` (local, gitignored):
 *   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, ALLOWED_EMAIL,
 *   COOKIE_ENCRYPTION_KEY, TOKEN_ENCRYPTION_KEY
 *
 * The top-level name is the dev worker on purpose: a deploy run without
 * `--env` can never touch production.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gobridge-dev",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-22",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"preview_urls": false,
	// Keep our own (content-free) log lines, but turn off the automatic
	// per-request invocation logs: they record full request URLs, and the
	// /callback and /link/callback URLs carry one-time Google auth codes.
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": false
		}
	},
	"dev": {
		"port": 8788
	},
	"migrations": [
		{
			"new_sqlite_classes": ["GoBridgeMCP"],
			"tag": "v1"
		},
		{
			"new_sqlite_classes": ["UsageCounter"],
			"tag": "v2"
		}
	],
	// Daily at 03:17 UTC: delete audit rows older than 90 days.
	"triggers": {
		"crons": ["17 3 * * *"]
	},
	"env": {
		"dev": {
			"name": "gobridge-dev",
			"vars": {
				"BASE_URL": "https://gobridge-dev.krishnakem.workers.dev",
				"WRITES_ENABLED": "true",
				"DAILY_SEND_CAP": "25",
				"READ_RATE_LIMIT_PER_HOUR": "300",
				"DIRECT_SEND_ENABLED": "true",
				"FORWARD_ENABLED": "true",
				"DRIVE_WRITE_ENABLED": "true",
				"DRIVE_SHARE_ENABLED": "true"
			},
			"secrets": {
				"required": [
					"GOOGLE_CLIENT_ID",
					"GOOGLE_CLIENT_SECRET",
					"ALLOWED_EMAIL",
					"COOKIE_ENCRYPTION_KEY",
					"TOKEN_ENCRYPTION_KEY"
				]
			},
			"durable_objects": {
				"bindings": [
					{ "class_name": "GoBridgeMCP", "name": "MCP_OBJECT" },
					{ "class_name": "UsageCounter", "name": "USAGE_COUNTER" }
				]
			},
			"kv_namespaces": [
				{ "binding": "OAUTH_KV", "id": "ff78f65975ba4390bb54ae3ea18c7977" },
				{ "binding": "GOOGLE_TOKENS", "id": "b17315b18c484813b41fe84d4f8528a4" }
			],
			"d1_databases": [
				{
					"binding": "AUDIT_DB",
					"database_name": "gobridge-audit-dev",
					"database_id": "ed679f78-421f-45f3-be6f-bd71fa3f1ca4",
					"migrations_dir": "migrations"
				}
			]
		},
		"production": {
			"name": "gobridge",
			"vars": {
				"BASE_URL": "https://gobridge.krishnakem.workers.dev",
				"WRITES_ENABLED": "true",
				"DAILY_SEND_CAP": "25",
				"READ_RATE_LIMIT_PER_HOUR": "300",
				"DIRECT_SEND_ENABLED": "true",
				"FORWARD_ENABLED": "true",
				"DRIVE_WRITE_ENABLED": "true",
				"DRIVE_SHARE_ENABLED": "true"
			},
			"secrets": {
				"required": [
					"GOOGLE_CLIENT_ID",
					"GOOGLE_CLIENT_SECRET",
					"ALLOWED_EMAIL",
					"COOKIE_ENCRYPTION_KEY",
					"TOKEN_ENCRYPTION_KEY"
				]
			},
			"durable_objects": {
				"bindings": [
					{ "class_name": "GoBridgeMCP", "name": "MCP_OBJECT" },
					{ "class_name": "UsageCounter", "name": "USAGE_COUNTER" }
				]
			},
			"kv_namespaces": [
				{ "binding": "OAUTH_KV", "id": "a8f32e217e6f44648351315340db75dd" },
				{ "binding": "GOOGLE_TOKENS", "id": "220cc7f6714845dc8c6ea845640edcef" }
			],
			"d1_databases": [
				{
					"binding": "AUDIT_DB",
					"database_name": "gobridge-audit",
					"database_id": "f5b2af01-a4ac-4bce-909b-7696b5c3fff6",
					"migrations_dir": "migrations"
				}
			]
		}
	}
}
